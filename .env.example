# ==============================================================================
# IndoJailbreak Environment Variables
# Copy this file to '.env' and fill in your actual API keys:
#   cp .env.example .env
# ==============================================================================

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-key-here

# Ollama Cloud / Remote Instance (Optional)
# If using a remote/cloud Ollama server (e.g. RunPod, AWS, Ngrok, or cloud host)
OLLAMA_ENDPOINT=https://your-remote-ollama-host:11434/api/generate
OLLAMA_API_KEY=your-bearer-token-if-protected
